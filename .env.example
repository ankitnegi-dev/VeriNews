# Copy this file to .env and fill in your own keys.
# Never commit .env.

# NewsAPI is primary; GNews is the fallback. The app stops at 80 live
# requests per UTC day even if a provider allows more.
NEWS_API_KEY=
GNEWS_API_KEY=

# Set to true to read only from .cache/ and never call a news API.
CACHE_ONLY=false
